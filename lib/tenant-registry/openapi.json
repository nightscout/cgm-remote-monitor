{
  "openapi": "3.1.0",
  "info": {
    "title": "Nightscout multitenant admin: tenant provisioning",
    "version": "1",
    "description": "The platform operator's provisioning resource on the admin role's private listener (decisions provisioning-split and operator-rest-api). Nightscout does not authenticate callers of this API; the deployment controls who can reach the admin listener. The idempotency key is the tenant id: a retried request returns 'existing'. A root secret is returned only once, on 'created', when the request sets issueRootSecret."
  },
  "paths": {
    "/v1/tenants": {
      "post": {
        "operationId": "provisionTenant",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "description": "When sent, must equal the tenant id.", "schema": { "$ref": "#/components/schemas/TenantId" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantRequest" } } } },
        "responses": {
          "201": { "description": "Created", "headers": { "Location": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantResult" } } } },
          "200": { "description": "Already provisioned with the same hosts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantResult" } } } },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/tenants/batch": {
      "post": {
        "operationId": "provisionTenants",
        "description": "At most 100 tenants. Each tenant is provisioned independently; the response has one result per tenant in request order. Duplicate ids or hosts inside one batch refuse the whole batch before any work.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "additionalProperties": false, "required": ["tenants"],
          "properties": { "tenants": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/TenantRequest" } } } } } } },
        "responses": {
          "200": { "description": "One result per tenant", "content": { "application/json": { "schema": {
            "type": "object", "additionalProperties": false, "required": ["results"],
            "properties": { "results": { "type": "array", "items": { "$ref": "#/components/schemas/TenantResult" } } } } } } },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/tenants/{id}": {
      "get": {
        "operationId": "getTenant",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/TenantId" } }],
        "responses": {
          "200": { "description": "The registry's view of the tenant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tenant" } } } },
          "404": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TenantId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "Host": { "type": "string", "maxLength": 253, "description": "A DNS name without a port; stored lower-case." },
      "TenantRequest": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": { "$ref": "#/components/schemas/TenantId" },
          "hosts": { "type": "array", "maxItems": 16, "items": { "$ref": "#/components/schemas/Host" }, "description": "Public aliases; at least one in direct-alias mode." },
          "internalHost": { "$ref": "#/components/schemas/Host", "description": "The canonical internal name; required in canonical-internal mode, refused otherwise." },
          "ref": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$", "description": "An opaque caller label echoed in the result." },
          "issueRootSecret": { "type": "boolean", "description": "Return the tenant's root secret once, on 'created'." }
        }
      },
      "TenantResult": {
        "type": "object", "additionalProperties": false, "required": ["id", "outcome"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "ref": { "type": "string" },
          "outcome": { "enum": ["created", "existing", "refused"] },
          "code": { "$ref": "#/components/schemas/Code" },
          "rootSecret": { "type": "string", "description": "Present only on 'created' with issueRootSecret." }
        }
      },
      "Tenant": {
        "type": "object", "additionalProperties": false, "required": ["id", "state", "signingVersion", "hosts"],
        "properties": {
          "id": { "$ref": "#/components/schemas/TenantId" },
          "state": { "enum": ["active", "removed"] },
          "signingVersion": { "type": "integer", "minimum": 1 },
          "hosts": { "type": "array", "items": { "$ref": "#/components/schemas/Host" } },
          "internalHost": { "$ref": "#/components/schemas/Host" }
        }
      },
      "Code": {
        "enum": ["TENANT_PROVISION_INVALID", "TENANT_PROVISION_HOST_INVALID", "TENANT_PROVISION_IDEMPOTENCY_KEY_MISMATCH", "TENANT_PROVISION_BATCH_INVALID",
          "TENANT_PROVISION_BATCH_DUPLICATE", "TENANT_PROVISION_CONFLICT", "TENANT_PROVISION_REMOVED", "TENANT_PROVISION_LOCK_COLLISION",
          "TENANT_PROVISION_VAULT_KEY_MISMATCH", "TENANT_PROVISION_VAULT_REFUSED", "TENANT_PROVISION_VAULT_UNAVAILABLE", "TENANT_PROVISION_FAILED",
          "TENANT_NOT_FOUND", "ROUTE_NOT_FOUND", "METHOD_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE", "PAYLOAD_TOO_LARGE", "BODY_INVALID", "SERVICE_CLOSED"]
      },
      "Problem": {
        "type": "object", "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "integer" },
          "code": { "$ref": "#/components/schemas/Code" }, "detail": { "type": "string" }, "id": { "type": ["string", "null"] }, "ref": { "type": "string" }
        }
      }
    },
    "responses": {
      "Problem": { "description": "RFC 9457 problem document", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    }
  }
}

{
  "id": "pgstream-input",
  "version": 1,
  "operations": {
    "hintEvaluatorInput": {
      "path": "/evaluator/input-hint",
      "maxBytes": 1024,
      "timeoutMs": 1000,
      "request": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "clock",
              "settings",
              "policy",
              "activity",
              "lifecycle"
            ]
          },
          "assignmentRevision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        },
        "required": [
          "tenant",
          "kind",
          "assignmentRevision"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      }
    }
  }
}

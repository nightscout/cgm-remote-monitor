                  "type": "string",
                  "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                },
                "owned": {
                  "type": "boolean"
                },
                "startupComplete": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "modelAvailable": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ready": {
                  "type": "boolean"
                },
                "stage": {
                  "enum": [
                    null,
                    "fetch",
                    "prepare",
                    "send"
                  ]
                },
                "stageActive": {
                  "type": "boolean"
                }
              },
              "required": [
                "tenant",
                "owned",
                "startupComplete",
                "modelAvailable",
                "ready"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "properties": {
                    "ready": {
                      "const": true
                    },
                    "owned": {
                      "const": true
                    },
                    "startupComplete": {
                      "const": true
                    },
                    "modelAvailable": {
                      "const": true
                    }
                  }
                },
                {
                  "properties": {
                    "ready": {
                      "const": false
                    }
                  }
                }
              ]
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "version": {
                "const": 1
              },
              "available": {
                "type": "boolean"
              },
              "runtime": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ticks": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "refreshes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "detected": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "detectFailures": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "ticks",
                      "refreshes",
                      "detected",
                      "detectFailures"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detector": {
                "type": "object",
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "polls": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "failures": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "available",
                  "polls",
                  "failures"
                ],
                "additionalProperties": false
              },
              "watchedCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "progress": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "entered": {
                        "type": "object",
                        "properties": {
                          "fetch": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "prepare": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "send": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "fetch",
                          "prepare",
                          "send"
                        ],
                        "additionalProperties": false
                      },
                      "inflight": {
                        "type": "object",
                        "properties": {
                          "fetch": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "prepare": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "send": {
                            "type": "integer",
                            "minimum": 0,

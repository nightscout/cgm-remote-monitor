{
  "id": "realtime-inspection",
  "version": 6,
  "operations": {
    "inspectRealtime": {
      "path": "/realtime/inspect",
      "request": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "realtime"
          },
          "observation": {
            "const": "cached-not-lock-proof"
          },
          "processIncarnation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "phase": {
            "enum": [
              "booted",
              "quiescing"
            ]
          },
          "ownerAvailable": {
            "type": "boolean"
          },
          "stats": {
            "type": "object",
            "properties": {
              "version": {
                "const": 1
              },
              "available": {
                "type": "boolean"
              },
              "runtime": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ticks": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "refreshes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "detected": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "detectFailures": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "ticks",
                      "refreshes",
                      "detected",
                      "detectFailures"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detector": {
                "type": "object",
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "polls": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "failures": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "available",
                  "polls",
                  "failures"
                ],
                "additionalProperties": false
              },
              "watchedCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "progress": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "entered": {
                        "type": "object",
                        "properties": {
                          "fetch": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "prepare": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "send": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "fetch",
                          "prepare",
                          "send"
                        ],
                        "additionalProperties": false
                      },
                      "inflight": {
                        "type": "object",
                        "properties": {
                          "fetch": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "prepare": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "send": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "fetch",
                          "prepare",
                          "send"
                        ],
                        "additionalProperties": false
                      },
                      "deadlines": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "skippedPasses": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "queued": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "entered",
                      "inflight",
                      "deadlines",
                      "skippedPasses",
                      "queued"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "version",
              "available",
              "runtime",
              "detector",
              "watchedCount"
            ],
            "additionalProperties": false
          },
          "ownership": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1023
                  },
                  "rule": {
                    "const": "sha256-modulo-v1"
                  }
                },
                "required": [
                  "count",
                  "ordinal",
                  "rule"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "kind",
          "observation",
          "processIncarnation",
          "phase",
          "ownerAvailable",
          "stats",
          "ownership"
        ],
        "additionalProperties": false
      }
    },
    "inspectRealtimeTenants": {
      "path": "/realtime/inspect-tenants",
      "request": {
        "type": "object",
        "properties": {
          "tenants": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            }
          }
        },
        "required": [
          "tenants"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "realtime"
          },
          "observation": {
            "const": "cached-readiness-not-lock-or-data-freshness-proof"
          },
          "processIncarnation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "phase": {
            "enum": [
              "booted",
              "quiescing"

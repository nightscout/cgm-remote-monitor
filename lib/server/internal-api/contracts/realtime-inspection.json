        "required": [
          "kind",
          "observation",
          "processIncarnation",
          "phase",
          "ownerAvailable",
          "tenants",
          "stats",
          "ownership"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "phase": {
                "const": "booted"
              },
              "ownerAvailable": {
                "const": true
              }
            }
          },
          {
            "properties": {

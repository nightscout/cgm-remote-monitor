                          }
                        },
                        "required": [
                          "fetch",
                          "prepare",
                          "send"
                        ],
                        "additionalProperties": false
                      },
                      "deadlines": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "skippedPasses": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "queued": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "entered",
                      "inflight",
                      "deadlines",
                      "skippedPasses",
                      "queued"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"

{
  "id": "role-health",
  "version": 1,
  "operations": {
    "getStatus": {
      "path": "/role/health",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "participant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "api",
                "evaluator",
                "realtime",
                "tenant-admin"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "ready": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "request",
          "participant",
          "roles",
          "ready"
        ]
      }
    }
  }
}

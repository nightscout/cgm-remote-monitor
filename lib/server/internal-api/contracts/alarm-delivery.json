{
  "id": "alarm-delivery",
  "version": 1,
  "operations": {
    "deliverAlarm": {
      "path": "/alarm",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "notification": {
            "type": "object",
            "description": "Extensible serialized notification produced by tenant-notifications/contract; transported without changing provider/plugin fields."
          },
          "receipts": {
            "type": "array",
            "items": true,
            "description": "Provider receipt JSON, retained unchanged for compatibility."
          }
        },
        "required": [
          "tenant",
          "id",
          "attempt",
          "notification",
          "receipts"
        ],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "accepted": {
            "const": true
          },
          "receipt": {
            "type": "null"
          },
          "clearedRequestIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "maxItems": 0
          }
        },
        "required": [
          "accepted",
          "receipt",
          "clearedRequestIds"
        ],
        "additionalProperties": false
      }
    }
  }
}

{
  "id": "completed-output",
  "version": 2,
  "operations": {
    "hintCompletedOutput": {
      "path": "/completed-output/hint",
      "request": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        },
        "required": [
          "tenant",
          "revision"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      }
    }
  }
}

{
  "id": "intake-state",
  "version": 1,
  "operations": {
    "inspectIntake": {
      "path": "/evaluator/intake-state",
      "maxBytes": 2048,
      "request": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "participant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "assignmentRevision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        },
        "required": [
          "request",
          "participant",
          "incarnation",
          "assignmentRevision"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "participant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "incarnation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "assignmentRevision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "controlRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "blocked",
              "recovering",
              "ready",
              "terminal"
            ]
          },
          "code": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "received": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "heartbeatAgeMs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          }
        },
        "required": [
          "request",
          "participant",
          "incarnation",
          "assignmentRevision",
          "controlRevision",
          "state",
          "code",
          "sequence",
          "received",
          "heartbeatAgeMs"
        ],
        "additionalProperties": false
      }
    }
  }
}

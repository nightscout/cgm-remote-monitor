{
  "id": "ownership-operations",
  "version": 1,
  "operations": {
    "listOwners": {
      "path": "/ownership/list",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "tenant"
        ],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "listed"
              },
              "owners": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "principal": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                    },
                    "consumer": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                    }
                  },
                  "required": [
                    "principal",
                    "consumer"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 64,
                "uniqueItems": true
              }
            },
            "required": [
              "outcome",
              "owners"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "No effect and no audit: the operator lacks current authority for this tenant, the tenant has no owner policy, or the input is invalid.",
            "properties": {
              "outcome": {
                "const": "denied"
              },
              "code": {
                "enum": [
                  "OWNERSHIP_FORBIDDEN",
                  "OWNERSHIP_TENANT_UNKNOWN",
                  "OWNERSHIP_INVALID"
                ]
              },
              "event": {
                "type": "null"
              }
            },
            "required": [
              "outcome",
              "code",
              "event"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "addOwner": {
      "path": "/ownership/add",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"

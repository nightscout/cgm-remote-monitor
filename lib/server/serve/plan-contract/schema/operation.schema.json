{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tenant operation cohort configuration (MULTITENANT_OPERATION_CONFIG)",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "connectionEnv",
    "registry"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "A PostgreSQL schema name."
    },
    "connectionEnv": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "The name of an environment variable in the process environment; the value is never written in a document."
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        }
      }
    },
    "leaseSessions": {
      "type": "integer",
      "minimum": 1
    },
    "participantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roles",
          "namespaces",
          "maxMessageBytes",
          "timeoutMs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          },
          "maxMessageBytes": {
            "type": "integer",
            "minimum": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "address": {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "description": "http://host:port"
              },
              "socket": {
                "type": "string",
                "description": "An absolute socket path."
              }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "description": "This instance's own serve.internal address, {url} or {socket}; required on every row of a role that more than one row names."
          },
          "slice": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              }
            },
            "required": [
              "count",
              "ordinal"
            ],
            "additionalProperties": false
          }
        }
      },
      "minItems": 1
    },
    "intakeProfile": {
      "type": "object",
      "required": [
        "binding",
        "digest",
        "contractDigest",
        "ownerKey"
      ],
      "description": "A generated intake-profile value. The loader validates the canonical binding and digests, then regenerates assignment. Incoming assignment and other envelope metadata grant no authority.",
      "properties": {
        "binding": {
          "type": "object",
          "description": "Canonical binding is validated by intake-profile.validate against the selected source capability."
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ownerKey": {
          "type": "string",
          "pattern": "^-?[0-9]{1,19}$"
        }
      }
    },
    "nativeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "lifecycleNamespace",
        "consumer",
        "source",
        "generation"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "lifecycleNamespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^evaluator-[A-Za-z0-9_-]{1,100}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system_id",
            "timeline",
            "database",
            "slot"
          ],
          "properties": {
            "system_id": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "timeline": {
              "type": "integer",
              "minimum": 1
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "slot": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$"
            }
          }
        }
      }
    }
  },
  "dependentRequired": {
    "participantId": [
      "participants"
    ],
    "participants": [
      "participantId"
    ]
  },
  "not": {
    "required": [
      "nativeSelection",
      "intakeProfile"
    ]
  }
}

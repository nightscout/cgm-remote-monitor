{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tenant operation cohort configuration (MULTITENANT_OPERATION_CONFIG)",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "connectionEnv",
    "registry"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "A PostgreSQL schema name."
    },
    "connectionEnv": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "The name of an environment variable in the process environment; the value is never written in a document."
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        }
      }
    },
    "leaseSessions": {
      "type": "integer",
      "minimum": 1
    },
    "participantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roles",
          "namespaces",
          "maxMessageBytes",
          "timeoutMs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          },
          "maxMessageBytes": {
            "type": "integer",
            "minimum": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "address": {
            "type": "string",
            "description": "This instance's own serve.internal address; required on every row of a role that more than one row names."
          },
          "worker": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "dependentRequired": {
    "participantId": [
      "participants"
    ],
    "participants": [
      "participantId"
    ]
  }
}

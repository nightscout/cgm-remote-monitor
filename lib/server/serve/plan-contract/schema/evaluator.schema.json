{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evaluator role configuration (MULTITENANT_EVALUATOR_CONFIG)",
  "description": "Registry mode. Loader: lib/server/serve/evaluator-config.js. The api role reads the same document as metadata when socketForwarding.consumerState names it.",
  "type": "object",
  "required": [
    "version",
    "postgres",
    "consumer",
    "pageSize",
    "maxRows",
    "maxBytes",
    "maxTenants",
    "timeIntervalMs",
    "registry",
    "tenantSettings",
    "pgstream",
    "trustedWorker",
    "activity"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "postgres": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "entries",
            "treatments",
            "devicestatus",
            "profile",
            "food",
            "activity",
            "clock",
            "checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "treatments": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "devicestatus": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "profile": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "food": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "activity": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "clock": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        }
      }
    },
    "consumer": {
      "type": "string",
      "pattern": "^evaluator-[A-Za-z0-9_-]{1,100}$"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxTenants": {
      "type": "integer",
      "minimum": 1
    },
    "timeIntervalMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        },
        "maxTenants": {
          "type": "integer",
          "minimum": 1
        },
        "refreshMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000
        }
      },
      "description": "Registry mode: the tenant set, hosts and keys come from the tenant registry in this namespace. A document that carries it carries no tenant list."
    },
    "tenantSettings": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "settings",
            "operatorPolicy"
          ],
          "additionalProperties": false,
          "properties": {
            "settings": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "operatorPolicy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        }
      }
    },
    "socketOrderDomains": {
      "type": "array",
      "items": {
        "enum": [
          "treatments",
          "devicestatus",
          "profile"
        ]
      },
      "uniqueItems": true
    },
    "activity": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        }
      }
    },
    "evictAfterMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "evaluationAlertMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "datastore": {
      "type": "object",
      "required": [
        "hostname",
        "port",
        "database"
      ],
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consumers": {
      "type": "object",
      "required": [
        "realtime"
      ],
      "additionalProperties": false,
      "properties": {
        "realtime": {
          "type": "object",
          "required": [
            "outbox",
            "suppression",
            "route",
            "maxPayloadBytes",
            "maxInflight",
            "attemptTimeoutMs",
            "retryDelayMs",
            "pollIntervalMs",
            "retryIntervalMs"
          ],
          "additionalProperties": false,
          "properties": {
            "outbox": {
              "type": "object",
              "required": [
                "connectionEnv",
                "namespace",
                "maxRows",
                "maxBytes",
                "maxConnections"
              ],
              "additionalProperties": false,
              "properties": {
                "connectionEnv": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
                  "description": "The name of an environment variable in the process environment; the value is never written in a document."
                },
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$",
                  "description": "A PostgreSQL schema name."
                },
                "maxRows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxConnections": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            },
            "suppression": {
              "type": "object",
              "required": [
                "connectionEnv",
                "namespace",
                "maxRows",
                "maxBytes",
                "maxConnections"
              ],
              "additionalProperties": false,
              "properties": {
                "connectionEnv": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
                  "description": "The name of an environment variable in the process environment; the value is never written in a document."
                },
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$",
                  "description": "A PostgreSQL schema name."
                },
                "maxRows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxConnections": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            },
            "route": {
              "type": "object",
              "required": [
                "id",
                "maxMessageBytes",
                "operationTimeoutMs"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "maxMessageBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "operationTimeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            },
            "maxPayloadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxInflight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "attemptTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "retryDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "retryIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxConcurrentTenants": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "partitionMetadata": {
              "type": "object",
              "required": [
                "checkpointNamespace",
                "membershipNamespace",
                "lifecycleNamespace"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpointNamespace": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$"
                },
                "membershipNamespace": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$"
                },
                "lifecycleNamespace": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$"
                }
              }
            }
          }
        }
      }
    },
    "trustedWorker": {
      "type": "object",
      "description": "Trusted worker cross-tenant metadata namespaces; ordinary worker SELECT policies, operational checks outside tenant jobs.",
      "required": [
        "activity",
        "clock",
        "settings",
        "operatorPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "activity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "clock": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "settings": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "operatorPolicy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        }
      }
    },
    "pgstream": {
      "type": "object",
      "description": "Durable CDC receiver for an independently managed pgstream service.",
      "required": [
        "receiver",
        "slot",
        "streamRole",
        "bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "streamRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "bounds": {
          "type": "object",
          "required": [
            "stepMs",
            "recoveryMs",
            "pendingMs"
          ],
          "additionalProperties": false,
          "properties": {
            "stepMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "recoveryMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "pendingMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "receiver": {
          "type": "object",
          "required": [
            "url",
            "trust",
            "bindHost",
            "maxBytes",
            "timeoutMs"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^http://[^/]+/$"
            },
            "trust": {
              "const": "network"
            },
            "bindHost": {
              "type": "string",
              "minLength": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "transactionRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Maximum rows accepted in one complete transport cohort, independent of the clinical working-set bound."
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "description": "Deployment stream incarnation, independent of PostgreSQL source identity and tenant restore generation."
        },
        "recovery": {
          "type": "object",
          "required": [
            "connectionEnv",
            "timeoutMs",
            "maxQueued"
          ],
          "additionalProperties": false,
          "properties": {
            "connectionEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "maxQueued": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          },
          "description": "Bounded native snapshot recovery; only the evaluator resolves this environment reference."
        }
      },
      "dependentRequired": {
        "generation": [
          "transactionRows"
        ],
        "recovery": [
          "transactionRows"
        ]
      }
    },
    "platformVerification": {
      "type": "object",
      "required": [
        "namespace",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^(?!public$|information_schema$|pg_)[a-z][a-z0-9_]{0,62}$"
        },
        "role": {
          "const": "evaluator"
        }
      },
      "description": "Explicit internal-admin verified platform state. Serving boot requires a current matching generation; tenant readiness remains separate."
    }
  }
}

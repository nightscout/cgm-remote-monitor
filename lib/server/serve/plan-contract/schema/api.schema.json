{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api role configuration (MULTITENANT_PREVIEW_CONFIG)",
  "description": "Registry mode. Loader: lib/server/serve/preview-config.js.",
  "type": "object",
  "required": [
    "version",
    "postgres",
    "vault",
    "resolution",
    "registry",
    "tenantSettings"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "postgres": {
      "type": "object",
      "required": [
        "connectionEnv",
        "readinessConnectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "readinessConnectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "entries",
            "authorization",
            "secrets",
            "legacy"
          ],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "authorization": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "secrets": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "legacy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "treatments": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "devicestatus": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "profile": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "food": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "activity": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "settings": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "access": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "clock": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          },
          "description": "One namespace per selected domain, plus access when accessTokens is given and clock when writeClock is true."
        }
      }
    },
    "vault": {
      "type": "object",
      "required": [
        "address",
        "mount"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "mount": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "tokenFile": {
          "type": "string",
          "description": "An absolute, normalized path; read at every use."
        },
        "tokenEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "allowInsecureLoopback": {
          "type": "boolean"
        }
      },
      "description": "One role-level Vault credential: exactly one of tokenFile and tokenEnv."
    },
    "resolution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "direct-alias",
            "canonical-internal"
          ]
        },
        "trustedPeers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        },
        "maxTenants": {
          "type": "integer",
          "minimum": 1
        },
        "refreshMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000
        }
      },
      "description": "Registry mode: the tenant set, hosts and keys come from the tenant registry in this namespace. A document that carries it carries no tenant list."
    },
    "tenantSettings": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "settings",
            "operatorPolicy"
          ],
          "additionalProperties": false,
          "properties": {
            "settings": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "operatorPolicy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "enum": [
          "entries",
          "treatments",
          "devicestatus",
          "profile",
          "food",
          "activity",
          "settings"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "legacy": {
      "type": "boolean"
    },
    "context": {
      "type": "boolean"
    },
    "writeClock": {
      "const": true
    },
    "accessTokens": {
      "type": "object",
      "required": [
        "issuer",
        "audience"
      ],
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "socketForwarding": {
      "type": "object",
      "required": [
        "maxTenants",
        "maxMessageBytes",
        "operationTimeoutMs",
        "alarm"
      ],
      "additionalProperties": false,
      "properties": {
        "maxTenants": {
          "type": "integer",
          "minimum": 1
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1
        },
        "operationTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "alarm": {
          "type": "object",
          "required": [
            "connectionEnv",
            "namespace"
          ],
          "additionalProperties": false,
          "properties": {
            "connectionEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "description": "The name of an environment variable in the process environment; the value is never written in a document."
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        },
        "consumerState": {
          "type": "object",
          "required": [
            "evaluatorConfigEnv"
          ],
          "additionalProperties": false,
          "properties": {
            "evaluatorConfigEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "description": "The name of an environment variable in the process environment; the value is never written in a document."
            }
          }
        }
      }
    },
    "subjectAdmin": {
      "type": "object",
      "required": [
        "writerConnectionEnv"
      ],
      "additionalProperties": false,
      "properties": {
        "writerConnectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "ownerPolicy": {
          "type": "object",
          "required": [
            "catalogue"
          ],
          "additionalProperties": false,
          "properties": {
            "catalogue": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        }
      },
      "description": "Activity reads use the API's tenant-bound serving connection."
    },
    "localDataAuthentication": {
      "const": "node",
      "description": "Registry mode with an explicit accessTokens realm; loader validates the dependency."
    },
    "platformVerification": {
      "type": "object",
      "required": [
        "namespace",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^(?!public$|information_schema$|pg_)[a-z][a-z0-9_]{0,62}$"
        },
        "role": {
          "const": "api"
        }
      },
      "description": "Explicit internal-admin verified platform state. Serving boot requires a current matching generation; tenant readiness remains separate."
    }
  },
  "dependentRequired": {
    "socketForwarding": [
      "writeClock",
      "legacy"
    ]
  }
}

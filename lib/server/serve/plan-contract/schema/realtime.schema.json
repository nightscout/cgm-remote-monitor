{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "realtime role configuration (MULTITENANT_REALTIME_CONFIG)",
  "description": "Registry mode. Loader: lib/server/realtime/config.js.",
  "type": "object",
  "required": [
    "version",
    "postgres",
    "consumer",
    "maxRows",
    "maxBytes",
    "maxTenants",
    "registry",
    "tenantSettings",
    "maxMessageBytes",
    "operationTimeoutMs",
    "completedOutput",
    "trustedWorker",
    "activity"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "postgres": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "clock",
            "checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "clock": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        }
      }
    },
    "consumer": {
      "type": "string",
      "pattern": "^realtime-[A-Za-z0-9_-]{1,112}$"
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxTenants": {
      "type": "integer",
      "minimum": 1
    },
    "registry": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        },
        "maxTenants": {
          "type": "integer",
          "minimum": 1
        },
        "refreshMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000
        }
      },
      "description": "Registry mode: the tenant set, hosts and keys come from the tenant registry in this namespace. A document that carries it carries no tenant list."
    },
    "tenantSettings": {
      "type": "object",
      "required": [
        "connectionEnv",
        "namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "connectionEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The name of an environment variable in the process environment; the value is never written in a document."
        },
        "namespaces": {
          "type": "object",
          "required": [
            "settings",
            "operatorPolicy"
          ],
          "additionalProperties": false,
          "properties": {
            "settings": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            },
            "operatorPolicy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "A PostgreSQL schema name."
            }
          }
        }
      }
    },
    "maxMessageBytes": {
      "type": "integer",
      "minimum": 1
    },
    "operationTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "activity": {
      "type": "object",
      "required": [
        "namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A PostgreSQL schema name."
        }
      }
    },
    "authorizationRecheckMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "unauthorizedDeadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "trustedWorker": {
      "type": "object",
      "description": "Trusted worker cross-tenant metadata namespaces; ordinary worker SELECT policies, operational checks outside tenant jobs.",
      "required": [
        "activity",
        "clock",
        "settings",
        "operatorPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "activity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "clock": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "settings": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "operatorPolicy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        }
      }
    },
    "completedOutput": {
      "type": "object",
      "description": "Required typed evaluator output source and independent current-authority metadata.",
      "required": [
        "namespace",
        "consumer"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^(?!pg_|public$|information_schema$)[a-z][a-z0-9_]{0,62}$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^evaluator-[A-Za-z0-9_-]{1,100}$"
        }
      }
    },
    "intakeProfile": {
      "type": "object",
      "required": [
        "binding",
        "digest",
        "contractDigest",
        "ownerKey"
      ],
      "description": "A generated intake-profile value. The loader validates the canonical binding and digests, then regenerates assignment. Incoming assignment and other envelope metadata grant no authority.",
      "properties": {
        "binding": {
          "type": "object",
          "description": "Canonical binding is validated by intake-profile.validate against the selected source capability."
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ownerKey": {
          "type": "string",
          "pattern": "^-?[0-9]{1,19}$"
        }
      }
    }
  }
}

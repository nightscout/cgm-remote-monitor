{
  "openapi": "3.0.3",
  "info": {
    "title": "Internal platform verification",
    "version": "1"
  },
  "paths": {
    "/v1/platform-verification": {
      "get": {
        "summary": "Read verification and current operation state",
        "responses": {
          "200": {
            "description": "Safe role generations, expiries and operation status"
          }
        }
      },
      "post": {
        "summary": "Verify configured platform schema and role privileges",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified namespace, validityMs, refreshMs and per-role generation/expiresAt bind the receipt"
          },
          "409": {
            "description": "Verification already running"
          },
          "503": {
            "description": "Verification failed; admission revoked"
          }
        }
      },
      "delete": {
        "summary": "Invalidate before a platform schema or privilege mutation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission revoked and concurrent verification fenced"
          },
          "503": {
            "description": "Invalidation failed; do not mutate platform state"
          }
        }
      }
    }
  }
}

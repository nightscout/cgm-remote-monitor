{
  "name": "nightscout",
  "version": "15.0.9",
  "description": "Nightscout acts as a web-based CGM (Continuous Glucose Montinor) to allow multiple caregivers to remotely view a patients glucose data in realtime.",
  "license": "AGPL-3.0",
  "author": "Nightscout Team",
  "homepage": "http://nightscout.github.io/",
  "keywords": [
    "diabetes",
    "continuous glucose management",
    "cgm in the cloud",
    "cgm",
    "dexcom"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nightscout/cgm-remote-monitor.git"
  },
  "contributors": [
    {
      "name": "Nightscout Team",
      "url": "https://github.com/nightscout/cgm-remote-monitor/graphs/contributors"
    }
  ],
  "bugs": {
    "url": "https://github.com/nightscout/cgm-remote-monitor/issues"
  },
  "scripts": {
    "start": "node lib/server/server.js",
    "test": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 5000 --require ./tests/hooks.js --exit ./tests/*.test.js",
    "test-single": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 5000 --require ./tests/hooks.js --exit ./tests/$TEST.test.js",
    "test:core": "mocha --timeout 5000 --exit ./tests/client-core/**/*.test.js",
    "test:dependencies": "npm ls brace-expansion postcss mocha nanoid js-yaml eslint nyc dompurify socket.io-parser fast-uri ip-address d3 d3-color express body-parser socket.io socket.io-client engine.io engine.io-client socket.io-adapter ws axios @babel/core @babel/preset-env babel-loader uuid --all && mocha --timeout 5000 --exit ./tests/dependency-*.test.js",
    "test-ci": "node bin/with-env.js ./tests/ci.test.env node_modules/nyc/bin/nyc.js --reporter=lcov --reporter=text-summary mocha --timeout 5000 --require ./tests/hooks.js --exit ./tests/*.test.js",
    "test:fast": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 5000 --require ./tests/hooks.js --exit --reporter min ./tests/*.test.js",
    "test:unit": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 5000 --require ./tests/hooks.js --exit --parallel --jobs 2 ./tests/{admintools,ar2,basalprofileplugin,bgnow,boluswizardpreview,bridge-connect-compat,cannulaage,careportal,cob,data.*,ddata,direction,env,errorcodes,expressextensions,hashauth,insulinage,iob,language,levels,loop,maker,mmconnect-connect-compat,mongo-pool-config,pluginbase,plugins,profile,profileeditor,pushover,query,sandbox,security,sensorage,settings,simplealarms,timeago,times,treatmentnotify,units,upbat,utils,verifyauth}.test.js",
    "test:unit:ci": "node bin/with-env.js ./tests/ci.test.env node_modules/mocha/bin/mocha.js --timeout 5000 --require ./tests/hooks.js --exit --parallel --jobs 2 ./tests/{admintools,ar2,basalprofileplugin,bgnow,boluswizardpreview,bridge-connect-compat,cannulaage,careportal,cob,data.*,ddata,direction,env,errorcodes,expressextensions,hashauth,insulinage,iob,language,levels,loop,maker,mmconnect-connect-compat,mongo-pool-config,pluginbase,plugins,profile,profileeditor,pushover,query,sandbox,security,sensorage,settings,simplealarms,timeago,times,treatmentnotify,units,upbat,utils,verifyauth}.test.js",
    "test:integration": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 15000 --require ./tests/hooks.js --exit ./tests/{adminnotifies,api,api3,client.renderer,dbsize,fail,flakiness-control,mongo-storage,notifications,notifications-api,openaps,pebble,pump,pushnotify,rawbg,reports,reportstorage,storage,websocket,XX_clean}*.test.js",
    "test:integration:ci": "node bin/with-env.js ./tests/ci.test.env node_modules/mocha/bin/mocha.js --timeout 15000 --require ./tests/hooks.js --exit ./tests/{adminnotifies,api,api3,client.renderer,dbsize,fail,flakiness-control,mongo-storage,notifications,notifications-api,openaps,pebble,pump,pushnotify,rawbg,reports,reportstorage,storage,websocket,XX_clean}*.test.js",
    "test:stress": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 60000 --require ./tests/hooks.js --exit ./tests/concurrent*.test.js",
    "test:stress:ci": "node bin/with-env.js ./tests/ci.test.env node_modules/mocha/bin/mocha.js --timeout 60000 --require ./tests/hooks.js --exit ./tests/concurrent*.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:all:ci": "npm run test:unit:ci && npm run test:integration:ci",
    "test:parallel": "node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 10000 --require ./tests/hooks.js --exit --parallel --jobs 2 ./tests/*.test.js",
    "test:parallel:ci": "CLEAR_REQUIRE_CACHE=true node bin/with-env.js ./tests/ci.test.env node_modules/nyc/bin/nyc.js --reporter=lcov --reporter=text-summary mocha --timeout 10000 --require ./tests/hooks.js --exit --parallel --jobs 2 ./tests/*.test.js",
    "env": "env",
    "postinstall": "webpack --mode production --config webpack/webpack.config.js && npm run-script post-generate-keys",
    "bundle": "webpack --mode production --config webpack/webpack.config.js && npm run-script post-generate-keys",
    "bundle-dev": "webpack --mode development --config webpack/webpack.config.js && npm run-script post-generate-keys",
    "bundle-analyzer": "webpack --mode development --config webpack/webpack.config.js --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "post-generate-keys": "node bin/generateRandomString.js >node_modules/.cache/_ns_cache/randomString",
    "coverage": "echo \"Coverage upload disabled\"",
    "dev": "node bin/with-env.js ./my.env node_modules/nodemon/bin/nodemon.js --inspect lib/server/server.js 0.0.0.0",
    "dev-test": "node bin/with-env.js ./my.devtest.env node_modules/nodemon/bin/nodemon.js --inspect lib/server/server.js 0.0.0.0",
    "prod": "node bin/with-env.js ./my.prod.env lib/server/server.js 0.0.0.0",
    "lint": "eslint lib",
    "test:flaky": "node scripts/flaky-test-runner.js",
    "test:flaky:quick": "FLAKY_TEST_ITERATIONS=3 node scripts/flaky-test-runner.js",
    "test:flaky:thorough": "FLAKY_TEST_ITERATIONS=20 node scripts/flaky-test-runner.js",
    "test:flaky:entries": "node scripts/flaky-harnesses/run-entries-isolation.js",
    "test:flaky:socket": "node scripts/flaky-harnesses/run-socket-isolation.js",
    "test:flaky:partial-failures": "node scripts/flaky-harnesses/run-partial-failures-isolation.js",
    "test:flaky:isolate": "node scripts/flaky-harnesses/run-isolate.js",
    "test:timing": "ENABLE_TIMING_WARNINGS=true node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 10000 --require ./tests/hooks.js --exit ./tests/*.test.js",
    "test:timing:single": "ENABLE_TIMING_WARNINGS=true node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 10000 --require ./tests/hooks.js --exit ./tests/$TEST.test.js",
    "test:slow": "SLOW_TEST_THRESHOLD=1000 node bin/with-env.js ./my.test.env node_modules/mocha/bin/mocha.js --timeout 10000 --require ./tests/hooks.js --exit ./tests/*.test.js",
    "test:browser": "mocha --timeout 30000 --require ./tests/browser/hooks.js ./tests/browser/*.test.js"
  },
  "main": "lib/server/server.js",
  "nodemonConfig": {
    "ignore": [
      "tests/*",
      "node_modules/*",
      "bin/*"
    ]
  },
  "config": {
    "blanket": {
      "pattern": [
        "tests",
        "lib",
        "server",
        "app",
        "static/js"
      ],
      "data-cover-never": [
        "node_modules"
      ]
    }
  },
  "engines": {
    "node": "^22.23.2 || ^24.20.0",
    "npm": ">=10.x"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1127.0",
    "@mongodb-js/saslprep": "^1.4.5",
    "@parse/node-apn": "^5.1.3",
    "axios": "^0.33.0",
    "braces": "^3.0.2",
    "compression": "^1.7.4",
    "csv-stringify": "^5.5.1",
    "d3": "^7.9.0",
    "easyxml": "^2.0.1",
    "ejs": "^3.1.8",
    "entities": "^6.0.1",
    "errorhandler": "^1.5.1",
    "events": "^3.3.0",
    "express": "4.22.2",
    "fast-password-entropy": "^1.1.1",
    "flot": "^0.8.3",
    "forwarded-for": "^1.1.0",
    "helmet": "^4.0.0",
    "jquery": "^3.5.1",
    "jquery-ui": "^1.14.2",
    "jsonwebtoken": "^9.0.0",
    "mime": "^2.4.6",
    "moment": "^2.27.0",
    "moment-timezone": "^0.5.31",
    "mongodb": "^7.6.0",
    "mongodb-connection-string-url": "7.0.2",
    "nightscout-connect": "https://github.com/nightscout/nightscout-connect/archive/5349d479f84fe455c4a0412dc9df53e84cd2582d.tar.gz",
    "node-cache": "^4.2.1",
    "process": "^0.11.10",
    "pushover-notifications": "^1.2.2",
    "sanitize-html": "2.17.7",
    "semver": "^6.3.0",
    "shiro-trie": "^0.4.9",
    "socket.io": "~4.8.3",
    "socks": "2.8.10",
    "swagger-ui-dist": "^4.13.2",
    "swagger-ui-express": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@types/tough-cookie": "^4.0.0",
    "babel-loader": "^10.1.1",
    "csv-parse": "^4.12.0",
    "dompurify": "^3.4.14",
    "eslint": "^7.19.0",
    "eslint-plugin-security": "^1.4.0",
    "eslint-webpack-plugin": "^2.7.0",
    "expose-loader": "^2.0.0",
    "mocha": "^11.8.0",
    "moment-timezone-data-webpack-plugin": "^1.5.0",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "playwright-core": "1.63.0",
    "should": "^13.2.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "webpack": "^5.74.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-middleware": "^8.0.3",
    "webpack-hot-middleware": "^2.25.2",
    "xml2js": "^0.5.0",
    "xss": "^1.0.15"
  },
  "overrides": {
    "follow-redirects": "1.16.0",
    "node-forge": "1.4.0",
    "lodash": "4.18.1",
    "ip-address": "10.7.0",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "flatted": "3.4.2",
    "picomatch": "2.3.2",
    "ajv@^6.0.0": "6.15.0",
    "ajv@^8.0.0": "8.18.0",
    "socket.io-parser": "4.2.7",
    "filelist": {
      "minimatch": "5.1.8"
    },
    "schema-utils@^4.0.0": {
      "ajv": "8.18.0"
    },
    "ajv-formats": {
      "ajv": "8.18.0"
    },
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    },
    "terser-webpack-plugin": "5.6.0",
    "nightscout-connect": {
      "axios": "1.20.0"
    },
    "brace-expansion@^1.0.0": "1.1.18",
    "brace-expansion@^2.0.0": "2.1.4",
    "brace-expansion@^5.0.0": "5.0.9",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "fast-uri@^3.0.0": "3.1.7"
  }
}
